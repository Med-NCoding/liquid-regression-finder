#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

usage() {
  cat <<'USAGE' >&2
Usage: bin/check <target>

Targets:
  stage-1   Verify pinned toolchain, lockfile install, contracts, Stage 1 interpreter tests, and liquid-spec plain-text pilot
  stage-2   Run Stage 1 regression checks, Stage 2 grammar/oracle/tracer/limit tests, 359/359 conformance report, and nested-loop trace demo
  stage-3..stage-10   Future stage gates (not yet implemented)
  all       Run all stage gates (fails until all stages are implemented)
USAGE
}

resolve_ruby() {
  if command -v ruby >/dev/null 2>&1; then
    echo "ruby"
  elif [ -x "/opt/homebrew/opt/ruby@3.3/bin/ruby" ]; then
    echo "/opt/homebrew/opt/ruby@3.3/bin/ruby"
  else
    echo "ERROR: ruby executable not found" >&2
    exit 1
  fi
}

resolve_bundle() {
  if command -v bundle >/dev/null 2>&1; then
    echo "bundle"
  elif [ -x "/opt/homebrew/opt/ruby@3.3/bin/bundle" ]; then
    echo "/opt/homebrew/opt/ruby@3.3/bin/bundle"
  else
    echo "ERROR: bundler executable not found" >&2
    exit 1
  fi
}

resolve_python() {
  if command -v python3.11 >/dev/null 2>&1; then
    echo "python3.11"
  elif [ -x "/opt/homebrew/opt/python@3.11/bin/python3.11" ]; then
    echo "/opt/homebrew/opt/python@3.11/bin/python3.11"
  elif command -v python3 >/dev/null 2>&1; then
    echo "python3"
  else
    echo "ERROR: python3.11 executable not found" >&2
    exit 1
  fi
}

resolve_node() {
  if command -v node >/dev/null 2>&1; then
    echo "node"
  elif [ -x "/usr/local/bin/node" ]; then
    echo "/usr/local/bin/node"
  else
    echo "ERROR: node executable not found" >&2
    exit 1
  fi
}

verify_pinned_toolchain() {
  local expected_ruby expected_python expected_node
  expected_ruby="$(tr -d '[:space:]' < "$ROOT_DIR/.ruby-version")"
  expected_python="$(tr -d '[:space:]' < "$ROOT_DIR/.python-version")"
  expected_node="$(tr -d '[:space:]' < "$ROOT_DIR/.node-version")"

  local ruby_bin bundle_bin python_bin node_bin
  ruby_bin="$(resolve_ruby)"
  bundle_bin="$(resolve_bundle)"
  python_bin="$(resolve_python)"
  node_bin="$(resolve_node)"

  local actual_ruby actual_bundle actual_python actual_node
  actual_ruby="$("$ruby_bin" -e 'print RUBY_VERSION')"
  actual_bundle="$("$bundle_bin" -v | awk '{print $NF}')"
  actual_python="$("$python_bin" -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')"
  actual_node="$("$node_bin" -v | sed 's/^v//')"

  echo "[toolchain] ruby=$actual_ruby (expected $expected_ruby) [$ruby_bin]"
  echo "[toolchain] bundler=$actual_bundle [$bundle_bin]"
  echo "[toolchain] python=$actual_python (expected $expected_python) [$python_bin]"
  echo "[toolchain] node=$actual_node (expected $expected_node) [$node_bin]"

  if [ "$actual_ruby" != "$expected_ruby" ]; then
    echo "ERROR: Ruby version mismatch: got $actual_ruby, expected $expected_ruby" >&2
    exit 1
  fi
  if [ "$actual_python" != "$expected_python" ]; then
    echo "ERROR: Python version mismatch: got $actual_python, expected $expected_python" >&2
    exit 1
  fi
  if [ "$actual_node" != "$expected_node" ]; then
    echo "ERROR: Node version mismatch: got $actual_node, expected $expected_node" >&2
    exit 1
  fi
}

ensure_bundle() {
  local bundle_bin
  bundle_bin="$(resolve_bundle)"
  "$bundle_bin" config set --local path vendor/bundle >/dev/null
  if ! "$bundle_bin" check >/dev/null 2>&1; then
    echo "[bundle] Installing locked gems into vendor/bundle..."
    BUNDLE_FROZEN=true "$bundle_bin" install
  fi
  "$bundle_bin" check
}

run_stage_1() {
  local bundle_bin
  bundle_bin="$(resolve_bundle)"

  echo "==> Stage 1 Gate: Toolchain & Lockfiles"
  verify_pinned_toolchain
  ensure_bundle

  echo "==> Stage 1 Gate: Contract Schemas & Examples"
  "$bundle_bin" exec ruby "$ROOT_DIR/contracts/test_contracts.rb"

  echo "==> Stage 1 Gate: Interpreter Bootstrap Unit Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_stage1_bootstrap.rb"

  echo "==> Stage 1 Gate: liquid-spec Plain-Text Pilot (basics & liquid_ruby)"
  "$bundle_bin" exec liquid-spec run "$ROOT_DIR/interpreter/liquid_spec_adapter.rb" \
    -s basics \
    -n "/^(empty_template|literal_passthrough|whitespace_preserved|newlines_preserved|raw_text_)/" \
    -v --list-passed

  "$bundle_bin" exec liquid-spec run "$ROOT_DIR/interpreter/liquid_spec_adapter.rb" \
    -s liquid_ruby \
    -n "StandardTagTest#test_no_transform" \
    -v --list-passed

  echo "==> Stage 1 Gate: Conformance Manifest & Report"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/bin/conformance_report" \
    --require-plain-text \
    --max-failures 20

  echo "PASS: bin/check stage-1 succeeded."
}

run_stage_2() {
  local bundle_bin
  bundle_bin="$(resolve_bundle)"

  echo "==> Stage 2 Gate: Stage 1 Regression Checks"
  run_stage_1

  echo "==> Stage 2 Gate: Lexer & Parser Unit Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_lexer_and_parser.rb"

  echo "==> Stage 2 Gate: Evaluator & Liquid 5.14.0 Oracle Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_evaluator_and_oracle.rb"

  echo "==> Stage 2 Gate: Tracer & Resource Limit Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_tracer_and_limits.rb"

  echo "==> Stage 2 Gate: Conformance Manifest & Full 359 Selected Specs"
  mkdir -p "$ROOT_DIR/artifacts/stage-2"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/bin/conformance_report" \
    --require-all-selected | tee "$ROOT_DIR/artifacts/stage-2/conformance-report.txt"

  echo "==> Stage 2 Gate: liquid-spec CLI Verification (basics & liquid_ruby)"
  "$bundle_bin" exec liquid-spec run "$ROOT_DIR/interpreter/liquid_spec_adapter.rb" \
    -s basics \
    -n "/^(boolean_chain_.*|nil_is_also_nil|nil_literal_outputs_nothing|nil_between_text|nil_equals_nil|nil_equals_undefined|nil_not_equals_(string|number|false|empty_string)|nil_is_falsy|nil_with_(or|and)_operator|nil_unless|nil_dot_property|nil_nested_property|nil_in_for_loop|nil_for_loop_else|nil_in_array_iteration_with_if|nil_assignment_vs_undefined|truthiness_only_false_and_nil_are_falsy|truthiness_zero_and_empty_string_are_truthy|truthiness_empty_collections_are_truthy|truthiness_in_contexts|scope_for_loop_variable_isolated|scope_for_shadows_outer_variable|for_basic_array|for_else|if_elsif|unless_variable)$/"

  "$bundle_bin" exec liquid-spec run "$ROOT_DIR/interpreter/liquid_spec_adapter.rb" \
    -s liquid_ruby \
    -n "/^(TrimModeTest#test_(complex|no_trim|post_|pre_and|pre_trim_tags|pre_trim_blank_preceding_text_(09a97fd4|60d5e7c9)|pre_trim_output|right_|single_|standard_|tag_output|trim_|variable_output|whitespace_).*|UnlessElseTagTest#test_unless(_else)?_[0-9a-f]+$|StatementsTest#test_(nil|not_nil|one_lq|strings|true_|var_|zero_).*|BlankTest#test_if_else_are_blank.*|AssignTest#test_assign_with_hyphen.*|HashRenderingTest#test_render_empty_hash.*|ParsingQuirksTest#test_(blank_variable|contains_in_id).*)$/"

  echo "==> Stage 2 Gate: Nested-Loop Trace Demo & Contract Validation"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/bin/nested_loop_demo" \
    --out "$ROOT_DIR/artifacts/stage-2/nested-loop-trace.json"

  echo "PASS: bin/check stage-2 succeeded."
}

if [ $# -ne 1 ]; then
  usage
  exit 2
fi

case "$1" in
  stage-1)
    run_stage_1
    ;;
  stage-2)
    run_stage_2
    ;;
  stage-3|stage-4|stage-5|stage-6|stage-7|stage-8|stage-9|stage-10)
    echo "ERROR: $1 gate is not implemented yet (highest implemented stage: stage-2)." >&2
    exit 2
    ;;
  all)
    run_stage_2
    echo "ERROR: bin/check all cannot pass yet: stage-3 through stage-10 are not implemented." >&2
    exit 2
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "ERROR: Unknown check target '$1'" >&2
    usage
    exit 2
    ;;
esac
