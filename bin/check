    --json-out "$ROOT_DIR/bench/reports/benchmark_details.json" \
    --md-out "$ROOT_DIR/bench/reports/benchmark.md"

  echo "==> Stage 7 Gate: Run Benchmark Accounting, Parity, Sample Baseline & Reproducibility Tests"
  "$python_bin" -m unittest discover -s "$ROOT_DIR/bench/tests" -v

  echo "PASS: bin/check stage-7 succeeded."
}

ensure_api_bundle() {
  local bundle_bin
  bundle_bin="$(resolve_bundle)"
  (
    cd "$ROOT_DIR/api"
    "$bundle_bin" config set --local path vendor/bundle >/dev/null
    if ! "$bundle_bin" check >/dev/null 2>&1; then
      echo "[api/bundle] Installing locked gems into api/vendor/bundle..."
      BUNDLE_FROZEN=true "$bundle_bin" install
    fi
    "$bundle_bin" check
  )
}

run_stage_8() {
  run_stage_7

  local bundle_bin
  bundle_bin="$(resolve_bundle)"

  echo "==> Stage 8 Gate: Ensure api/ Locked Gems"
  ensure_api_bundle

  echo "==> Stage 8 Gate: Verify api/ Migrations & Solid Queue Configuration"
  (
    cd "$ROOT_DIR/api"
    RAILS_ENV=test "$bundle_bin" exec bin/rails db:migrate
    RAILS_ENV=production "$bundle_bin" exec bin/rails db:migrate
    RAILS_ENV=production "$bundle_bin" exec bin/rails solid_queue:check
    RAILS_ENV=test "$bundle_bin" exec bin/rails runner "ComparisonReconciler.reconcile!"
  )

  echo "==> Stage 8 Gate: Run Rails API, Job, Reconciliation, Subprocess & Log Redaction Tests"
  (
    cd "$ROOT_DIR/api"
    "$bundle_bin" exec bin/rails test -v
  )

  echo "==> Stage 8 Gate: End-to-End Rails Server + Solid Queue Worker Smoke Check"
  mkdir -p "$ROOT_DIR/artifacts/stage-8"
  (
    cd "$ROOT_DIR/api"
    "$bundle_bin" exec ruby "$ROOT_DIR/api/bin/e2e_smoke_check" \
      --report-out "$ROOT_DIR/artifacts/stage-8/e2e-smoke-report.json"
  )

  echo "PASS: bin/check stage-8 succeeded."
}

ensure_web_modules() {
  local node_bin npm_bin
  node_bin="$(resolve_node)"
  npm_bin="$(resolve_npm)"
  if [ ! -d "$ROOT_DIR/web/node_modules" ]; then
    echo "[web/npm] Installing locked npm packages from web/package-lock.json..."
    (
      export PATH="$(dirname "$node_bin"):$PATH"
      cd "$ROOT_DIR/web"
      if [ -f "$ROOT_DIR/web/package-lock.json" ]; then
        "$npm_bin" ci
      else
        "$npm_bin" install
      fi
    )
  fi
}

run_stage_9() {
  run_stage_8

  local node_bin npm_bin
  node_bin="$(resolve_node)"
  npm_bin="$(resolve_npm)"

  echo "==> Stage 9 Gate: Ensure web/ Locked npm Packages"
  ensure_web_modules

  echo "==> Stage 9 Gate: TypeScript Typecheck, Vitest UI Suite, & Vite Production Build"
  (
    export PATH="$(dirname "$node_bin"):$PATH"
    cd "$ROOT_DIR/web"
    "$npm_bin" run typecheck
    "$npm_bin" test
    "$npm_bin" run build
  )

  echo "==> Stage 9 Gate: Real Rails + Solid Queue + Vite + Headless Chrome E2E Verification"
  mkdir -p "$ROOT_DIR/artifacts/stage-9"
  (
    export PATH="$(dirname "$node_bin"):$PATH"
    cd "$ROOT_DIR/web"
    "$node_bin" "$ROOT_DIR/web/tests/e2e_browser.mjs"
  )

  echo "PASS: bin/check stage-9 succeeded."
}

run_stage_10() {
  run_stage_9

  local bundle_bin python_bin
  bundle_bin="$(resolve_bundle)"
  python_bin="$(resolve_python)"

  echo "==> Stage 10 Gate: PR Check CLI Unit & Stdlib-Only Tests"
  "$python_bin" -m unittest discover -s "$ROOT_DIR/bin/tests" -v

  echo "==> Stage 10 Gate: Validate GitHub Actions Workflow YAML & Watched Snippet"
  "$bundle_bin" exec ruby -ryaml -e 'YAML.safe_load_file(ARGV[0], aliases: true)' "$ROOT_DIR/.github/workflows/liquid-regression.yml"
  test -f "$ROOT_DIR/comparison-manifest.json"
  test -f "$ROOT_DIR/snippets/card-product.liquid"

  echo "==> Stage 10 Gate: Real Rails + Solid Queue PR Dry Run"
  mkdir -p "$ROOT_DIR/artifacts/stage-10"
  "$python_bin" "$ROOT_DIR/bin/pr_dry_run" \
    --report-out "$ROOT_DIR/artifacts/stage-10/pr-dry-run-report.json" \
    --summary-out "$ROOT_DIR/artifacts/stage-10/pr-dry-run-summary.md"

  echo "PASS: bin/check stage-10 succeeded."
}

if [ $# -ne 1 ]; then
  usage
  exit 2
fi

case "$1" in
  stage-1)
    run_stage_1
    ;;
  stage-2)
    run_stage_2
    ;;
  stage-3)
    run_stage_3
    ;;
  stage-4)
    run_stage_4
    ;;
