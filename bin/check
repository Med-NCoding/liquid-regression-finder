#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

usage() {
  cat <<'USAGE' >&2
Usage: bin/check <target>

Targets:
  stage-1   Verify pinned toolchain, lockfile install, contracts, Stage 1 interpreter tests, and liquid-spec plain-text pilot
  stage-2   Run Stage 1 regression checks, Stage 2 grammar/oracle/tracer/limit tests, selected conformance report, and nested-loop trace demo
  stage-3   Run Stage 1-2 regression checks, Stage 3 projection/observer/reference/worker tests, and ordinary-product parity verification
  stage-4   Run Stage 1-3 regression checks, Stage 4 Python stdlib search tests, schema validation, and live demo/negative CLI checks
  stage-5   Run Stage 1-4 regression checks, Stage 5 shrink/explanation/replay acceptance checks, and contract schema validation
  stage-6   Run Stage 1-5 regression checks, Stage 6 Dawn corpus witness verification, and corpus unit tests
  stage-7   Run Stage 1-6 regression checks, Stage 7 interpreter extensions, benchmark runner/reports, reproducibility & accounting tests
  stage-8   Run Stage 1-7 regression checks, Stage 8 Rails API & Solid Queue tests, migrations, and end-to-end HTTP + worker smoke check
  stage-9   Run Stage 1-8 regression checks, Stage 9 React typecheck, Vitest UI tests, Vite build, and headless Chrome API-to-browser E2E
  stage-10  Run Stage 1-9 regression checks, PR check unit tests, workflow YAML validation, and Rails+Solid Queue PR dry run
  all       Run all stage gates (stage-1 through stage-10)
USAGE
}

resolve_ruby() {
  if command -v ruby >/dev/null 2>&1; then
    echo "ruby"
  elif [ -x "/opt/homebrew/opt/ruby@3.3/bin/ruby" ]; then
    echo "/opt/homebrew/opt/ruby@3.3/bin/ruby"
  else
    echo "ERROR: ruby executable not found" >&2
    exit 1
  fi
}

resolve_bundle() {
  if command -v bundle >/dev/null 2>&1; then
    echo "bundle"
  elif [ -x "/opt/homebrew/opt/ruby@3.3/bin/bundle" ]; then
    echo "/opt/homebrew/opt/ruby@3.3/bin/bundle"
  else
    echo "ERROR: bundler executable not found" >&2
    exit 1
  fi
}

resolve_python() {
  if command -v python3.11 >/dev/null 2>&1; then
    echo "python3.11"
  elif [ -x "/opt/homebrew/opt/python@3.11/bin/python3.11" ]; then
    echo "/opt/homebrew/opt/python@3.11/bin/python3.11"
  elif command -v python3 >/dev/null 2>&1; then
    echo "python3"
  else
    echo "ERROR: python3.11 executable not found" >&2
    exit 1
  fi
}

resolve_node() {
  if command -v node >/dev/null 2>&1; then
    echo "node"
  elif [ -x "/usr/local/bin/node" ]; then
    echo "/usr/local/bin/node"
  else
    echo "ERROR: node executable not found" >&2
    exit 1
  fi
}

resolve_npm() {
  if command -v npm >/dev/null 2>&1; then
    echo "npm"
  elif [ -x "/usr/local/bin/npm" ]; then
    echo "/usr/local/bin/npm"
  else
    echo "ERROR: npm executable not found" >&2
    exit 1
  fi
}

verify_pinned_toolchain() {
  local expected_ruby expected_python expected_node
  expected_ruby="$(tr -d '[:space:]' < "$ROOT_DIR/.ruby-version")"
  expected_python="$(tr -d '[:space:]' < "$ROOT_DIR/.python-version")"
  expected_node="$(tr -d '[:space:]' < "$ROOT_DIR/.node-version")"

  local ruby_bin bundle_bin python_bin node_bin
  ruby_bin="$(resolve_ruby)"
  bundle_bin="$(resolve_bundle)"
  python_bin="$(resolve_python)"
  node_bin="$(resolve_node)"

  local actual_ruby actual_bundle actual_python actual_node
  actual_ruby="$("$ruby_bin" -e 'print RUBY_VERSION')"
  actual_bundle="$("$bundle_bin" -v | awk '{print $NF}')"
  actual_python="$("$python_bin" -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')"
  actual_node="$("$node_bin" -v | sed 's/^v//')"

  echo "[toolchain] ruby=$actual_ruby (expected $expected_ruby) [$ruby_bin]"
  echo "[toolchain] bundler=$actual_bundle [$bundle_bin]"
  echo "[toolchain] python=$actual_python (expected $expected_python) [$python_bin]"
  echo "[toolchain] node=$actual_node (expected $expected_node) [$node_bin]"

  if [ "$actual_ruby" != "$expected_ruby" ]; then
    echo "ERROR: Ruby version mismatch: got $actual_ruby, expected $expected_ruby" >&2
    exit 1
  fi
  if [ "$actual_python" != "$expected_python" ]; then
    echo "ERROR: Python version mismatch: got $actual_python, expected $expected_python" >&2
    exit 1
  fi
  if [ "$actual_node" != "$expected_node" ]; then
    echo "ERROR: Node version mismatch: got $actual_node, expected $expected_node" >&2
    exit 1
  fi
}

ensure_bundle() {
  local bundle_bin
  bundle_bin="$(resolve_bundle)"
  "$bundle_bin" config set --local path vendor/bundle >/dev/null
  if ! "$bundle_bin" check >/dev/null 2>&1; then
    echo "[bundle] Installing locked gems into vendor/bundle..."
    BUNDLE_FROZEN=true "$bundle_bin" install
  fi
  "$bundle_bin" check
}

run_stage_1() {
  local bundle_bin
  bundle_bin="$(resolve_bundle)"

  echo "==> Stage 1 Gate: Toolchain & Lockfiles"
  verify_pinned_toolchain
  ensure_bundle

  echo "==> Stage 1 Gate: Contract Schemas & Examples"
  "$bundle_bin" exec ruby "$ROOT_DIR/contracts/test_contracts.rb"

  echo "==> Stage 1 Gate: Interpreter Bootstrap Unit Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_stage1_bootstrap.rb"

  echo "==> Stage 1 Gate: liquid-spec Plain-Text Pilot (basics & liquid_ruby)"
  "$bundle_bin" exec liquid-spec run "$ROOT_DIR/interpreter/liquid_spec_adapter.rb" \
    -s basics \
    -n "/^(empty_template|literal_passthrough|whitespace_preserved|newlines_preserved|raw_text_)/" \
    -v --list-passed

  "$bundle_bin" exec liquid-spec run "$ROOT_DIR/interpreter/liquid_spec_adapter.rb" \
    -s liquid_ruby \
    -n "StandardTagTest#test_no_transform" \
    -v --list-passed

  echo "==> Stage 1 Gate: Conformance Manifest & Report"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/bin/conformance_report" \
    --require-plain-text \
    --max-failures 20

  echo "PASS: bin/check stage-1 succeeded."
}

run_stage_2() {
  local bundle_bin
  bundle_bin="$(resolve_bundle)"

  echo "==> Stage 2 Gate: Stage 1 Regression Checks"
  run_stage_1

  echo "==> Stage 2 Gate: Lexer & Parser Unit Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_lexer_and_parser.rb"

  echo "==> Stage 2 Gate: Evaluator & Liquid 5.14.0 Oracle Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_evaluator_and_oracle.rb"

  echo "==> Stage 2 Gate: Tracer & Resource Limit Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_tracer_and_limits.rb"

  echo "==> Stage 2 Gate: Conformance Manifest & Full Selected Specs"
  mkdir -p "$ROOT_DIR/artifacts/stage-2"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/bin/conformance_report" \
    --require-all-selected | tee "$ROOT_DIR/artifacts/stage-2/conformance-report.txt"

  echo "==> Stage 2 Gate: liquid-spec CLI Verification (basics & liquid_ruby)"
  "$bundle_bin" exec liquid-spec run "$ROOT_DIR/interpreter/liquid_spec_adapter.rb" \
    -s basics \
    -n "/^(boolean_chain_.*|nil_is_also_nil|nil_literal_outputs_nothing|nil_between_text|nil_equals_nil|nil_equals_undefined|nil_not_equals_(string|number|false|empty_string)|nil_is_falsy|nil_with_(or|and)_operator|nil_unless|nil_dot_property|nil_nested_property|nil_in_for_loop|nil_for_loop_else|nil_in_array_iteration_with_if|nil_assignment_vs_undefined|truthiness_only_false_and_nil_are_falsy|truthiness_zero_and_empty_string_are_truthy|truthiness_empty_collections_are_truthy|truthiness_in_contexts|scope_for_loop_variable_isolated|scope_for_shadows_outer_variable|for_basic_array|for_else|if_elsif|unless_variable)$/"

  "$bundle_bin" exec liquid-spec run "$ROOT_DIR/interpreter/liquid_spec_adapter.rb" \
    -s liquid_ruby \
    -n "/^(TrimModeTest#test_(complex|no_trim|post_|pre_and|pre_trim_tags|pre_trim_blank_preceding_text_(09a97fd4|60d5e7c9)|pre_trim_output|right_|single_|standard_|tag_output|trim_|variable_output|whitespace_).*|UnlessElseTagTest#test_unless(_else)?_[0-9a-f]+$|StatementsTest#test_(nil|not_nil|one_lq|strings|true_|var_|zero_).*|BlankTest#test_if_else_are_blank.*|AssignTest#test_assign_with_hyphen.*|HashRenderingTest#test_render_empty_hash.*|ParsingQuirksTest#test_(blank_variable|contains_in_id).*)$/"

  echo "==> Stage 2 Gate: Nested-Loop Trace Demo & Contract Validation"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/bin/nested_loop_demo" \
    --out "$ROOT_DIR/artifacts/stage-2/nested-loop-trace.json"

  echo "PASS: bin/check stage-2 succeeded."
}

run_stage_3() {
  local bundle_bin
  bundle_bin="$(resolve_bundle)"

  echo "==> Stage 3 Gate: Stage 1 & Stage 2 Regression Checks"
  run_stage_2

  echo "==> Stage 3 Gate: Projection, Fixture Validator & Probe Matrix Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/reference/test/test_projection.rb"

  echo "==> Stage 3 Gate: Observer & Official Liquid 5.14.0 Reference Renderer Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/reference/test/test_observer_and_reference.rb"

  echo "==> Stage 3 Gate: Persistent JSONL Worker Protocol Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/reference/test/test_jsonl_worker.rb"

  echo "==> Stage 3 Gate: Ordinary Sale & Non-Sale Parity Verification via JSONL Worker"
  mkdir -p "$ROOT_DIR/artifacts/stage-3"
  "$bundle_bin" exec ruby "$ROOT_DIR/reference/bin/ordinary_parity_check"

  echo "PASS: bin/check stage-3 succeeded."
}

run_stage_4() {
  local bundle_bin python_bin
  bundle_bin="$(resolve_bundle)"
  python_bin="$(resolve_python)"

  echo "==> Stage 4 Gate: Stage 1-3 Regression Checks"
  run_stage_3

  echo "==> Stage 4 Gate: Verify fixtures/demo/ Contains Only Liquid Snippets"
  local demo_entries
  demo_entries="$(cd "$ROOT_DIR/fixtures/demo" && ls -1 | LC_ALL=C sort | tr '\n' ',')"
  if [ "$demo_entries" != "after.liquid,before.liquid," ]; then
    echo "ERROR: fixtures/demo/ must contain only before.liquid and after.liquid; found: $demo_entries" >&2
    exit 1
  fi

  echo "==> Stage 4 Gate: Python Search Unit & Real-Worker Integration Tests"
  "$python_bin" -m unittest discover -s "$ROOT_DIR/search/tests" -v

  echo "==> Stage 4 Gate: Live Demo Compare CLI Verification (Expect Exit 1)"
  mkdir -p "$ROOT_DIR/artifacts/stage-4"
  local demo_rc=0
  "$python_bin" -m search compare \
    --before "$ROOT_DIR/fixtures/demo/before.liquid" \
    --after "$ROOT_DIR/fixtures/demo/after.liquid" \
    --observer sale_badge \
    --seed 0 \
    --search-pairs 256 \
    --shrink-pairs 128 \
    --replay-out "$ROOT_DIR/artifacts/stage-4/demo-replay.json" \
    > "$ROOT_DIR/artifacts/stage-4/demo-compare.json" || demo_rc=$?
  if [ "$demo_rc" -ne 1 ]; then
    echo "ERROR: Expected exit code 1 from demo compare, got $demo_rc" >&2
    exit 1
  fi
  echo "[demo] python -m search compare exited with $demo_rc (difference_found)"

  echo "==> Stage 4 Gate: Live Identical-Template Negative CLI Verification (Expect Exit 0)"
  local ident_rc=0
  "$python_bin" -m search compare \
    --before "$ROOT_DIR/fixtures/demo/before.liquid" \
    --after "$ROOT_DIR/fixtures/demo/before.liquid" \
    --observer sale_badge \
    --seed 0 \
    --search-pairs 16 \
    --shrink-pairs 128 \
    > "$ROOT_DIR/artifacts/stage-4/identical-compare.json" || ident_rc=$?
  if [ "$ident_rc" -ne 0 ]; then
    echo "ERROR: Expected exit code 0 from identical compare, got $ident_rc" >&2
    exit 1
  fi
  echo "[identical] python -m search compare exited with $ident_rc (no_difference_found)"

  echo "==> Stage 4 Gate: Validate Generated Reports & ReplayBundle Against Contracts"
  "$bundle_bin" exec ruby "$ROOT_DIR/search/tests/validate_stage4_schemas.rb" \
    --compare-report "$ROOT_DIR/artifacts/stage-4/demo-compare.json" \
    --compare-report "$ROOT_DIR/artifacts/stage-4/identical-compare.json" \
    --replay-bundle "$ROOT_DIR/artifacts/stage-4/demo-replay.json"

  echo "PASS: bin/check stage-4 succeeded."
}

run_stage_5() {
  local bundle_bin python_bin
  bundle_bin="$(resolve_bundle)"
  python_bin="$(resolve_python)"

  echo "==> Stage 5 Gate: Stage 1-4 Regression Checks"
  run_stage_4

  echo "==> Stage 5 Gate: Live Demo Compare + Shrink + Explanation (Expect Exit 1)"
  mkdir -p "$ROOT_DIR/artifacts/stage-5"
  local demo_rc=0
  "$python_bin" -m search compare \
    --before "$ROOT_DIR/fixtures/demo/before.liquid" \
    --after "$ROOT_DIR/fixtures/demo/after.liquid" \
    --observer sale_badge \
    --seed 0 \
    --search-pairs 256 \
    --shrink-pairs 128 \
    --replay-out "$ROOT_DIR/artifacts/stage-5/demo-replay.json" \
    > "$ROOT_DIR/artifacts/stage-5/demo-compare.json" || demo_rc=$?
  if [ "$demo_rc" -ne 1 ]; then
    echo "ERROR: Expected exit code 1 from Stage 5 demo compare, got $demo_rc" >&2
    exit 1
  fi
  echo "[stage-5 demo] python -m search compare exited with $demo_rc (difference_found)"

  echo "==> Stage 5 Gate: Fresh-Process Deterministic Replay Verification (Expect Exit 0)"
  local replay_rc=0
  "$python_bin" -m search replay \
    --bundle "$ROOT_DIR/artifacts/stage-5/demo-replay.json" \
    > "$ROOT_DIR/artifacts/stage-5/demo-replay-result.json" || replay_rc=$?
  if [ "$replay_rc" -ne 0 ]; then
    echo "ERROR: Expected exit code 0 from Stage 5 replay, got $replay_rc" >&2
    exit 1
  fi

  local replay_tmp
  replay_tmp="$(mktemp)"
  trap 'rm -f "${replay_tmp:-}"' RETURN
  local replay2_rc=0
  "$python_bin" -m search replay \
    --bundle "$ROOT_DIR/artifacts/stage-5/demo-replay.json" \
    > "$replay_tmp" || replay2_rc=$?
  if [ "$replay2_rc" -ne 0 ]; then
    echo "ERROR: Expected exit code 0 from second fresh-process replay, got $replay2_rc" >&2
    exit 1
  fi

  echo "==> Stage 5 Gate: Live Identical-Template Negative CLI Verification (Expect Exit 0)"
  local ident_rc=0
  "$python_bin" -m search compare \
    --before "$ROOT_DIR/fixtures/demo/before.liquid" \
    --after "$ROOT_DIR/fixtures/demo/before.liquid" \
    --observer sale_badge \
    --seed 0 \
    --search-pairs 16 \
    --shrink-pairs 128 \
    > "$ROOT_DIR/artifacts/stage-5/identical-compare.json" || ident_rc=$?
  if [ "$ident_rc" -ne 0 ]; then
    echo "ERROR: Expected exit code 0 from Stage 5 identical compare, got $ident_rc" >&2
    exit 1
  fi

  echo "==> Stage 5 Gate: End-to-End Acceptance Assertions"
  "$python_bin" - "$ROOT_DIR/artifacts/stage-5/demo-compare.json" "$ROOT_DIR/artifacts/stage-5/demo-replay-result.json" "$replay_tmp" "$ROOT_DIR/artifacts/stage-5/identical-compare.json" <<'PY'
import json
import sys
from pathlib import Path

cmp_report = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
rep1 = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
rep2 = json.loads(Path(sys.argv[3]).read_text(encoding="utf-8"))
ident = json.loads(Path(sys.argv[4]).read_text(encoding="utf-8"))

assert cmp_report["status"] == "difference_found"
assert cmp_report["reference_status"] == "confirmed"
assert cmp_report["stats"]["shrink_pairs"] > 0
assert cmp_report["shrink"]["local_fixed_point"] is True
assert tuple(cmp_report["shrink"]["post_shrink_measure"]) < tuple(cmp_report["shrink"]["pre_shrink_measure"])
assert "minimized fixture" in cmp_report["message"]

exp = cmp_report["finding"]["explanation"]
assert exp["kind"] == "structural_change"
assert exp["before"]["line"] == 3
assert exp["after"]["line"] == 1
assert exp["summary"].startswith("Structural change:")

det_keys = (
    "schema_version", "status", "direction", "reference_status",
    "finding", "product", "before", "after", "reference",
    "explanation", "replay", "provenance", "error",
)
for k in det_keys:
    assert rep1[k] == rep2[k], f"Fresh replay mismatch on {k}"
assert rep1["finding"] == cmp_report["finding"]
assert rep1["reference"]["before"]["observed"] == rep1["before"]["observed"]
assert rep1["reference"]["after"]["observed"] == rep1["after"]["observed"]
assert rep1["replay"]["liquid_version"] == "5.14.0"

assert ident["status"] == "no_difference_found"
assert ident["message"] == "no difference found within this search"
assert ident["stats"]["search_pairs"] == 16
assert ident["stats"]["shrink_pairs"] == 0
print("[stage-5] All 4 core acceptance invariants verified (shrink_pairs=%d, pre=%s -> post=%s)" % (
    cmp_report["stats"]["shrink_pairs"],
    cmp_report["shrink"]["pre_shrink_measure"],
    cmp_report["shrink"]["post_shrink_measure"],
))
PY

  echo "==> Stage 5 Gate: Validate Stage 5 Reports, ReplayBundle, & ReplayResult via JSONSchemer"
  "$bundle_bin" exec ruby "$ROOT_DIR/search/tests/validate_stage5_schemas.rb" \
    --compare-report "$ROOT_DIR/artifacts/stage-5/demo-compare.json" \
    --compare-report "$ROOT_DIR/artifacts/stage-5/identical-compare.json" \
    --replay-bundle "$ROOT_DIR/artifacts/stage-5/demo-replay.json" \
    --replay-result "$ROOT_DIR/artifacts/stage-5/demo-replay-result.json"

  echo "PASS: bin/check stage-5 succeeded."
}

run_stage_6() {
  run_stage_5

  local bundle_bin
  bundle_bin="$(resolve_bundle)"

  echo "==> Stage 6 Gate: Verify Dawn Corpus Manifest, Witness Fixtures, & Liquid 5.14.0 Renders"
  "$bundle_bin" exec ruby "$ROOT_DIR/bench/verify_corpus.rb" \
    --report-out "$ROOT_DIR/artifacts/stage-6/corpus-verification.json" \
    --summary-out "$ROOT_DIR/artifacts/stage-6/corpus-summary.md"

  echo "==> Stage 6 Gate: Run Dawn Corpus Minitest Suite"
  "$bundle_bin" exec ruby "$ROOT_DIR/bench/tests/test_dawn_corpus.rb"

  echo "PASS: bin/check stage-6 succeeded."
}

run_stage_7() {
  run_stage_6

  local bundle_bin python_bin
  bundle_bin="$(resolve_bundle)"
  python_bin="$(resolve_python)"

  echo "==> Stage 7 Gate: Liquid Engine Extension & Oracle Tests"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/test/test_stage7_extensions.rb"

  echo "==> Stage 7 Gate: Verify Expanded Conformance Manifest (100% Selected)"
  mkdir -p "$ROOT_DIR/artifacts/stage-7"
  "$bundle_bin" exec ruby "$ROOT_DIR/interpreter/bin/conformance_report" \
    --require-all-selected | tee "$ROOT_DIR/artifacts/stage-7/conformance-report.txt"

  echo "==> Stage 7 Gate: Regenerate Benchmark Reports & Measure IPC Overhead"
