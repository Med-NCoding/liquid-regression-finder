{%- comment -%}
  Shopify Storefront Product Projection Probe Template
  Install as: templates/product.projection-probe.liquid in a draft Shopify theme.
  Request with: /products/<handle>?view=projection-probe
  Notes:
    - Outputs raw JSON (no theme layout) for all aggregate and variant fields modeled by
      LiquidReference::Projection (PROJECTION_VERSION = "1.0.0").
    - Uses Shopify Liquid's `| json` filter so nil vs 0 vs false are serialized unambiguously.
{%- endcomment -%}
{%- layout none -%}
{
  "probe_template_version": "1.0.0",
  "shop": {
    "currency": {{ shop.currency | json }},
    "money_format": {{ shop.money_format | json }}
  },
  "product": {
    "id": {{ product.id | json }},
    "handle": {{ product.handle | json }},
    "price": {{ product.price | json }},
    "price_min": {{ product.price_min | json }},
    "price_max": {{ product.price_max | json }},
    "price_varies": {{ product.price_varies | json }},
    "compare_at_price": {{ product.compare_at_price | json }},
    "compare_at_price_min": {{ product.compare_at_price_min | json }},
    "compare_at_price_max": {{ product.compare_at_price_max | json }},
    "compare_at_price_varies": {{ product.compare_at_price_varies | json }},
    "available": {{ product.available | json }},
    "variants": [
      {%- for v in product.variants -%}
      {
        "id": {{ v.id | json }},
        "price": {{ v.price | json }},
        "compare_at_price": {{ v.compare_at_price | json }},
        "available": {{ v.available | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
