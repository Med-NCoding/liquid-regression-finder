{%- assign selected_variant = nil -%}
{%- assign first_variant = nil -%}
{%- for v in product.variants -%}
  {%- if first_variant == nil -%}
    {%- assign first_variant = v -%}
  {%- endif -%}
  {%- if selected_variant == nil and v.available -%}
    {%- assign selected_variant = v -%}
  {%- endif -%}
{%- endfor -%}
{%- if selected_variant == nil -%}
  {%- assign selected_variant = first_variant -%}
{%- endif -%}
<div class="product-form__buttons">
  <button
    type="submit"
    name="add"
    class="product-form__submit button button--full-width button--primary"
    {% if selected_variant.available == false or variant_meta.quantity_rule.min > variant_meta.inventory_quantity %}
      disabled
    {% endif %}
  >
    <span>
      {%- if selected_variant.available -%}
        {%- if variant_meta.quantity_rule.min > variant_meta.inventory_quantity -%}
          <span data-regression-badge="sold_out">{{ 'products.product.sold_out' | t }}</span>
        {%- else -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- endif -%}
      {%- else -%}
        <span data-regression-badge="sold_out">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </span>
  </button>
</div>
